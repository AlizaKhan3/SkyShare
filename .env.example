# Appwrite Cloud (free plan) — copy to .env and fill in values

VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_TEXT_TABLE_ID=text_sharing
VITE_APPWRITE_FILES_TABLE_ID=file_sharing
VITE_APPWRITE_BUCKET_ID=files

# Required for same-Wi-Fi rooms — deploy functions/room-id in Appwrite Console first
VITE_APPWRITE_ROOM_FUNCTION_ID=
# Function domain from Appwrite → Functions → room-id → Domains
VITE_APPWRITE_ROOM_FUNCTION_URL=
